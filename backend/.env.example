# Which model the host uses: groq (default) or gemini
LLM_PROVIDER=groq
# Optional: override the provider's default model
LLM_MODEL=

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Photon 2.0 (fill in once the project and phone line exist)
PHOTON_API_KEY=
PHOTON_PHONE_NUMBER=
