# Copy to .env and fill in. Never commit .env.

# Which model the host uses: groq (default) or gemini
LLM_PROVIDER=groq
# Optional: override the provider's default model
LLM_MODEL=

# Free key: https://console.groq.com/keys
# Also powers speech to text and the role voices. Accept the voice model's terms once at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
GROQ_API_KEY=
# Free key, backup model: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Photon 2.0 (Beta), for texting the station over iMessage
# Project API key, starts with pho_sk_ (NOT the project id)
PHOTON_API_KEY=
# Project id, starts with pho_prj_: https://app.beta.photon.codes/project/settings
PHOTON_PROJECT_ID=
# The station's iMessage line
PHOTON_PHONE_NUMBER=
# Your own iPhone's iMessage number, E.164 format (+1...), for testing
PHOTON_TEST_SENDER=
# Set to off to run the server without answering texts
PHOTON_IMESSAGE=on

# Optional: change a role's voice (Groq Orpheus voice names)
# VOICE_CITIZEN=autumn
# VOICE_JOURNALIST=troy
# VOICE_OFFICIAL=austin
# VOICE_HISTORIAN=diana
